{
  "name": "club-lectura-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "API Backend Club de Lectura Pago",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --experimental-vm-modules --test tests/*.test.js",
    "test:postgres": "node --test --test-timeout=90000 tests/pagos-postgres.integration.js",
    "test:pagos": "npm run test && npm run test:postgres",
    "pagos:conciliar": "node scripts/conciliar-pagos.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "mercadopago": "3.6.1",
    "nodemailer": "^10.0.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "embedded-postgres": "18.4.0-beta.17",
    "nodemon": "^3.0.0",
    "pg": "8.23.1"
  }
}
